# Copy to .env and fill in. .env is gitignored — never commit real values.

# Ollama runs locally, no API key needed. Defaults to http://localhost:11434
# if unset. Model tags: confirm exact tag after `ollama pull` (registry naming
# can differ slightly from marketing names).
OLLAMA_HOST=
OLLAMA_LLM_MODEL=medgemma1.5:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# NCBI E-utilities: an API key raises the rate limit above the anonymous
# 3 req/sec default. Register at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# NCBI usage guidelines require identifying the tool and a contact email
# on every E-utilities request.
NCBI_TOOL_NAME=pico-pubmed-rag
NCBI_EMAIL=
